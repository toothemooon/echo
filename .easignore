# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Python
__pycache__/
*.pyc

# Local quote datasets, research and generated audit data
/QUOTE_CONTEXTS.json
/assets/quotes.json
/assets/quotes.zh-Hans.json
/assets/quotes.ja.json
/data/quote-audit/*.json
/quotes_*.txt

# Runtime quote datasets required by ECHO.
# These files stay out of Git but are uploaded by local EAS builds.
!/QUOTE_CONTEXTS.json
!/assets/quotes.json
!/assets/quotes.zh-Hans.json
!/assets/quotes.ja.json
