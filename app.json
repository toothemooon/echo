{
  "expo": {
    "name": "ECHO",
    "slug": "ECHO",
    "version": "1.0.0",
    "scheme": "echo",
    "orientation": "portrait",
    "icon": "./assets/echo-icon-light.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/echo-icon-light.png",
      "supportsTablet": false,
      "bundleIdentifier": "yachts.sarada.echo",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "itms-apps",
          "mailto",
          "market"
        ]
      }
    },
    "android": {
      "icon": "./assets/echo-icon-light.png",
      "adaptiveIcon": {
        "backgroundColor": "#F4EAD7",
        "foregroundImage": "./assets/echo-icon-light.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "yachts.sarada.echo",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/echo-icon-light.png"
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-asset",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Dark",
            "ios": "./assets/echo-icon-dark.png",
            "android": {
              "foregroundImage": "./assets/echo-icon-dark.png",
              "backgroundColor": "#0A0D0E"
            }
          },
          {
            "name": "Archive",
            "ios": "./assets/echo-icon-archive.png",
            "android": {
              "foregroundImage": "./assets/echo-icon-archive.png",
              "backgroundColor": "#C6A66B"
            }
          }
        ]
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E5E0D8",
          "image": "./assets/echo-icon-light.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#1A1A18",
            "image": "./assets/echo-icon-dark.png"
          }
        }
      ],
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "31027af5-fe6e-41bf-9cee-23204247f355"
      }
    },
    "owner": "hsc110110"
  }
}
